# --- Market data (read-only) --------------------------------------------
# twelvedata: live quotes (free key at https://twelvedata.com)
# dukascopy: free history with bid/ask, ~1h delay (used for backtests)
DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
CACHE_DIR=/app/cache

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Optional comma-separated list of additional allowed chat ids
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Risk ----------------------------------------------------------------
RISK_PERCENT=1.0
# Fixed paper balance in account currency.
PAPER_BALANCE=10000
ACCOUNT_CURRENCY=USD

# --- Runtime -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=/app/logs
DATABASE_URL=sqlite:////app/data/bot.db
STRATEGY_CONFIG=config/strategy.yaml
